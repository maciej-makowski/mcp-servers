# Thin wrapper image: official npm @notionhq/notion-mcp-server (stdio) proxied
# to Streamable HTTP by supergateway. Flags verified against supergateway's
# README (2026-10): --stdio, --outputTransport streamableHttp, --port, --host,
# --apiKey. Auth is supplied at runtime via OPENAPI_MCP_HEADERS (never baked
# in) and the gateway key via MCP_BEARER (also never baked in).
# --host 0.0.0.0 is explicit (supergateway's default already binds all
# interfaces, but we don't rely on an implicit default for port publishing).
#
# AUTH: supergateway's --apiKey requires every request to carry the key as
# `Authorization: Bearer <key>` (or `X-API-Key`) and answers 401 otherwise —
# exactly the bearer contract Hermes already speaks. The key is MCP_BEARER,
# injected from the mcp-owned env file by the quadlet, so the CMD is shell
# form (exec form would not expand it). An empty MCP_BEARER makes the gateway
# refuse to start rather than run unauthenticated.
FROM node:22-slim

RUN npm install -g @notionhq/notion-mcp-server supergateway \
    && npm cache clean --force

EXPOSE 8013

CMD supergateway --stdio notion-mcp-server --outputTransport streamableHttp --port 8013 --host 0.0.0.0 --apiKey "$MCP_BEARER"
