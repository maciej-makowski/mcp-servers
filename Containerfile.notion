# Thin wrapper image: official npm @notionhq/notion-mcp-server (stdio) proxied
# to Streamable HTTP via supergateway. Flags verified against supergateway's
# README (2026-10): --stdio, --outputTransport streamableHttp, --port, --host.
# Auth is supplied at runtime via OPENAPI_MCP_HEADERS (never baked in).
# --host 0.0.0.0 is explicit (supergateway's default already binds all
# interfaces, but we don't rely on an implicit default for port publishing).
FROM node:22-slim

RUN npm install -g @notionhq/notion-mcp-server supergateway \
    && npm cache clean --force

EXPOSE 8013

CMD ["supergateway", "--stdio", "notion-mcp-server", "--outputTransport", "streamableHttp", "--port", "8013", "--host", "0.0.0.0"]
