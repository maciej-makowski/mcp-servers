# strava-mcp env file template (strava design section 3.3; deploy/README.md).
# Copy to /home/mcp/env/strava.env (0600, owned by mcp) and fill the values
# as Maciek: never commit filled values. STRAVA_CLIENT_ID and
# STRAVA_CLIENT_SECRET come from the API application at
# strava.com/settings/api (Authorization Callback Domain: 127.0.0.1).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
MCP_BEARER=
MCP_HOST=0.0.0.0
MCP_PORT=8016
