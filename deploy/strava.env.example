# strava-mcp env file template (strava-design-final.md, section 'Token
# lifecycle'; deploy/README.md). Copy to
# /home/mcp/env/strava.env (0600,
# owned by mcp) and fill the values as Maciek: never commit filled values.
# STRAVA_CLIENT_ID and STRAVA_CLIENT_SECRET come from the API application at
# strava.com/settings/api (Authorization Callback Domain: 127.0.0.1).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
MCP_BEARER=
MCP_HOST=0.0.0.0
MCP_PORT=8016
# Scope string the authorization URL requests (oauth.py reads it; the value
# below is the scope set granted at first deployment, unchanged). A later
# attended re-authorization appends read_all here before running the flow.
STRAVA_OAUTH_SCOPES=read,profile:read_all,activity:read_all

# --- local store + sync ---
# Non-secret configuration; the values below are the design's recommended
# defaults. The store directory itself is not a key: the quadlet mounts
# %h/strava-store on /app/store and the store module uses that path the way
# oauth.py uses /app/data/token.json. Reserves (10 per 15 minutes, 100 daily)
# stay in code (rate.py constants) - they are not configurable here.
# Rollout default is false (nothing syncs until the operator's go-card
# approval flips it to true). Turn the whole sync off again by setting it
# back to false; the serving tools and the strava_sync status/trigger tool
# stay up either way.
STRAVA_SYNC_ENABLED=false
STRAVA_SYNC_FREQUENT_HOURS=6
STRAVA_SYNC_SLOW_HOURS=24
STRAVA_SYNC_SWEEP_DAYS=7
STRAVA_SYNC_BULK_CAP=60
