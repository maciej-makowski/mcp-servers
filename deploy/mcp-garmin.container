# User-mode quadlet for the `mcp` user: garmin-mcp HTTP server (garmin design
# section 5, option C, port 8017). Image from the monorepo's images.yml
# workflow (Containerfile.garmin, multi-arch).
#
# Bearer auth is enforced by the shared _shared/mcp_auth.require_bearer
# middleware (MCP_BEARER from the env file, fail-closed). The same env file
# carries GARMIN_API_KEY, the Garmin Connect Personal API key the server
# exchanges for a 24 h bearer token in-process (re-deriving it from the key
# when under one hour of validity remains). One env file, two credentials;
# no secret ever in the image or this file.
#
# Volume mounts:
#   %h/mcp-logs/garmin -> /app/logs, audit JSONL (the google/outlook/strava
#   MCP_LOGS_DIR pattern; without the override the audit module defaults to
#   ~/.hermes/mcp-logs, which is what native stdio runs use).
#   %h/garmin-store -> /home/mcp/garmin-store, the on-box local archive store
#   (garmin-local-archive-design-final.md Rev 7, OD-2: 0700 bind dir owned by
#   mcp; the root backup cron and the 09:43 checker reach the SAME host path,
#   so the store must be bind-mounted, not container-internal).
#
# Like the others: loopback-only publish. No spool mount and no keep-id
# mapping: garmin-mcp touches only its logs volume and its store mount.
[Unit]
Description=garmin-mcp HTTP server (isolated)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/maciej-makowski/mcp-garmin:latest
ContainerName=mcp-garmin
EnvironmentFile=%h/env/garmin.env
PublishPort=127.0.0.1:8017:8017
Volume=%h/mcp-logs/garmin:/app/logs:Z
Volume=%h/garmin-store:/home/mcp/garmin-store:Z
Environment=MCP_LOGS_DIR=/app/logs

[Service]
Restart=on-failure
RestartSec=5
MemoryMax=384M

[Install]
WantedBy=default.target

