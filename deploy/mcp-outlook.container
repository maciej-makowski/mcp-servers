# ~/.config/containers/systemd/mcp-outlook.container
# USER-mode quadlet for the dedicated `mcp` user (rootless podman 5.4.2, arm64
# rpi5-0). Runs the Outlook MCP server (mail/calendar/tasks/onedrive tools)
# from ghcr.io/maciej-makowski/mcp-outlook:latest. Hermes (native, on the
# hermes user) reaches it at http://127.0.0.1:8012 — loopback ONLY, never on
# the LAN.
#
# Secrets: MCP_BEARER lives in %h/env/outlook.env (0600, owned by mcp) and
# is NEVER baked into the image or this file.
#
# TOKEN MAPPING — why the volume looks odd: outlook/outlook_mcp/graph.py has
# TOKEN_FILE = os.path.expanduser("~/.config/office365/tokens.json") HARDCODED.
# There is no env override, and the container runs as root internally (no USER
# in the Containerfile), so expanduser() resolves to /root inside the container.
# The simplest correct approach is to bind-mount the mcp-owned host dir straight
# onto the absolute in-container path the code already looks at:
#
#   host  /home/mcp/outlook-token/          ->  container /root/.config/office365/
#         └── tokens.json                       └── tokens.json
#
# graph.py both READS and WRITES the token there (refresh + atomic os.replace
# under a .lock file), so the mount must be read-write and the host dir must be
# owned by the mcp user (uid mapped through rootless podman; :Z relabels).
#
# Image NOT digest-pinned yet — digest pinning follows the signal-cli pattern
# once the digests are stable (see deploy/README.md).
[Unit]
Description=Outlook MCP server (mail/calendar/tasks/onedrive, HTTP bearer auth, port 8012)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/maciej-makowski/mcp-outlook:latest
ContainerName=mcp-outlook
# MCP_BEARER, MCP_HOST, MCP_PORT from the mcp-owned env file (0600).
EnvironmentFile=%h/env/outlook.env
# Publish to the host loopback only — native Hermes reaches it at 127.0.0.1:8012.
PublishPort=127.0.0.1:8012:8012
# MSAL token store: see TOKEN MAPPING above. Host dir created + seeded by the
# operator (deploy/README.md one-time steps); owned by mcp, tokens 0600 inside.
Volume=%h/outlook-token:/root/.config/office365:Z
# Server audit/activity logs, owned by mcp. outlook_mcp/audit.py honours the
# MCP_LOGS_DIR env override, so this must match the /app/logs mount above.
Environment=MCP_LOGS_DIR=/app/logs
Volume=%h/mcp-logs/outlook:/app/logs:Z

[Service]
Restart=on-failure
RestartSec=5
# Keep the three MCP containers from crowding out native Hermes on the box.
MemoryMax=384M

[Install]
WantedBy=default.target
